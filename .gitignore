# ============================================================
#  ic-bench .gitignore
#  Goal: keep the repo source-only. Anything large / binary /
#  regenerable should stay out. Task fixtures that are small
#  and required (.csv .json .v .py .sh .toml Dockerfile ...) are
#  intentionally NOT ignored.
#
#  If a task genuinely needs a file matching a rule below, force
#  add it explicitly:  git add -f <path>
# ============================================================

# ---------- OS / editor junk ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
.idea/
.vscode/
*.swp
*.swo
*~
.vim/
.history/

# ---------- credentials / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
.netrc
credentials.json
id_rsa*
id_ed25519*
id_ecdsa*
.aws/
.ssh/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
