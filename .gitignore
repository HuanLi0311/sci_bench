# Required CUA reference deliverables and archived model submissions.
!tasks/cua/*/solution/*.blend
!tasks/cua/*/authoring/runs/**/submission/*.blend
!tasks/cua/*/authoring/runs/**/*.blend
!tasks/cua/evaluation/**/*.blend
!tasks/cua/*/authoring/runs/historical/**/artifacts/app/out/*.blend
!tasks/cua/toy-car/environment/materials/videos/*.mp4
*.fbx
*.stl

# ---------- misc big / generated ----------
*.bak.*
*.dump
*.sql.gz
*.sql
dump.rdb
# Raw local evaluation evidence is a required part of the CUA task pack.
!tasks/cua/*/authoring/runs/**/*.log
!tasks/cua/*/authoring/runs/**/out/
!tasks/cua/*/authoring/runs/**/out/**
.terraform/
*.tfstate
*.tfstate.*
node_modules/.cache/

# ---------- agent episode debug dumps ----------
# Regenerable per-episode traces. Each debug.json can be 20-50MB and a
# single model run produces hundreds of them, which makes git push hang
# and get disconnected by GitHub. Keep them local only.
**/agent/**/debug.json
**/agent/episode-*/debug.json
**/agent/**/debug.json.*
